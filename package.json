{
  "name": "@musetric/landing",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0 --port 3003",
    "build:project": "vite build --configLoader native && vite build --configLoader native --ssr src/staticPage.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "check:translations": "i18next-cli extract --config ./i18next.config.ts --ci --dry-run",
    "fix:translations": "i18next-cli extract --config ./i18next.config.ts",
    "check:deps:security": "npm audit --audit-level high",
    "check:unused": "knip",
    "check:format": "prettier --check .",
    "fix:format": "prettier . --write --list-different",
    "check:dupe": "jscpd src scripts --config .jscpd.json",
    "check:editorconfig": "editorconfig-checker",
    "check:english": "musetric-checks english",
    "check:notices": "musetric-checks notices",
    "check:links": "musetric-checks links",
    "check:comments": "musetric-checks comments",
    "check:deps": "musetric-deps",
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mui/material": "9.5.0",
    "@musetric/checks": "0.3.0",
    "@musetric/eslint-config": "0.2.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "i18next": "27.0.1",
    "i18next-cli": "1.87.0",
    "jiti": "2.7.0",
    "knip": "6.44.2",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.6"
  }
}
