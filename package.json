{
  "name": "@musetric/landing",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0 --port 3003",
    "build:project": "vite build --configLoader native",
    "check:translations": "i18next-cli extract --config ./i18next.config.ts --ci --dry-run",
    "fix:translations": "i18next-cli extract --config ./i18next.config.ts",
    "check:deps:security": "npm audit --audit-level high",
    "check:unused": "knip",
    "check:format": "prettier --check .",
    "fix:format": "prettier . --write --list-different",
    "check:dupe": "jscpd src scripts --config .jscpd.json",
    "check:editorconfig": "editorconfig-checker",
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content"
  },
  "devDependencies": {
    "@musetric/eslint-config": "0.1.0-dev.gaf19b52",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.5.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.0",
    "i18next-cli": "1.73.1",
    "jiti": "2.7.0",
    "knip": "6.41.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "i18next": "26.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16"
  }
}
