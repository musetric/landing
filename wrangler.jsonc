{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musetric-landing",
  "compatibility_date": "2026-05-17",
  "routes": [{ "pattern": "musetric.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
